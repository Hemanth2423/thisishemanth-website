---
import '../styles/global.css';
import { site } from '../config';
import LeafCanvas from '../components/LeafCanvas.astro';
import LightScene from '../components/LightScene.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConnectCta from '../components/ConnectCta.astro';
import SkyCycle from '../components/SkyCycle.astro';
import TimeStatus from '../components/TimeStatus.astro';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  published?: Date;
}
const { title, description = site.description, type = 'website', image, published } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Product work and writing shaped by nature`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = image ? new URL(image, Astro.url.origin).href : undefined;

const themeScript = `(function(){try{var hour=Number(new Intl.DateTimeFormat('en-US',{timeZone:'America/Los_Angeles',hour:'2-digit',hourCycle:'h23'}).format(new Date())),a=hour<5?'night':hour<7?'dawn':hour<9?'sunrise':hour<17?'day':hour<19?'sunset':hour<21?'dusk':'night',colors={dawn:'#f6e3d6',sunrise:'#f6d7a5',day:'#eef0e0',sunset:'#e7ad72',dusk:'#9b684d',night:'#131d24'};document.documentElement.dataset.theme=a;document.documentElement.dataset.autoTheme=a;var m=document.querySelector('meta[name=theme-color]');if(m)m.content=colors[a];}catch(e){}})();`;
---
<!doctype html>
<html lang="en" data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeScript} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#eef0e0" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="relative flex flex-col">
    <a href="#main" class="sr-only z-50 rounded-full bg-paper px-4 py-2 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <LightScene />
    <LeafCanvas />
    <Header />
    <SkyCycle />
    <main id="main" class="relative z-10 mx-auto w-full max-w-5xl flex-1 px-5 sm:px-8">
      <slot />
    </main>
    <Footer />
    <TimeStatus />
    <ConnectCta />
  </body>
</html>
