---
const options = [
  { id: 'dawn', label: 'Dawn', icon: '◒' },
  { id: 'day', label: 'Day', icon: '☀' },
  { id: 'sunset', label: 'Dusk', icon: '◐' },
  { id: 'night', label: 'Night', icon: '☾' },
];
---
<div class="sky-dial" aria-label="Choose the sky">
  <span class="sky-dial-label">Sky</span>
  <div class="sky-dial-options" role="group" aria-label="Colour mode">
    {options.map((option) => (
      <button type="button" class="sky-button" data-sky={option.id} aria-label={`${option.label} mode`} title={option.label}>
        <span aria-hidden="true">{option.icon}</span>
      </button>
    ))}
    <button type="button" class="sky-button sky-auto" data-sky="auto" aria-label="Use local time" title="Follow local time">↻</button>
  </div>
</div>
<script>
  const root = document.documentElement;
  const colors: Record<string, string> = { dawn: '#f6e3d6', day: '#eef0e0', sunset: '#f2cdb4', night: '#131d24' };
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sky]');
  const setTheme = (theme: string) => {
    const value = theme === 'auto' ? root.dataset.autoTheme ?? 'day' : theme;
    root.dataset.theme = value;
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', colors[value]);
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.sky === theme)));
  };
  const saved = localStorage.getItem('sky-theme');
  setTheme(saved ?? 'auto');
  buttons.forEach((button) => button.addEventListener('click', () => {
    const choice = button.dataset.sky ?? 'auto';
    if (choice === 'auto') localStorage.removeItem('sky-theme'); else localStorage.setItem('sky-theme', choice);
    setTheme(choice);
  }));
</script>
