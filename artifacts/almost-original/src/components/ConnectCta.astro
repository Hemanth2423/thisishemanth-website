---
import { site } from '../config';
---
<aside aria-label="Connect" class="fixed bottom-5 right-5 z-30 w-max max-w-[calc(100%-2.5rem)] sm:bottom-7 sm:right-7">
  <nav class="connect-links" aria-label="Find Hemanth online">
    <a href={site.linkedinUrl} rel="me noopener" target="_blank">LinkedIn</a>
    <a href={site.githubUrl} rel="noopener noreferrer" target="_blank">GitHub</a>
    <a href={site.resumeUrl} rel="noopener noreferrer" target="_blank">Resume</a>
  </nav>
</aside>
