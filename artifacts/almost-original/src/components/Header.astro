---
import { url } from '../config';
import Sprig from './Sprig.astro';

const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const items = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/work/', label: 'Work', match: (p: string) => p.startsWith('/work') },
  { href: '/scribbles/', label: 'Scribbles', match: (p: string) => p.startsWith('/scribbles') },
];
---
<header class="relative z-10 mx-auto flex w-full max-w-5xl items-center justify-between gap-6 px-5 pt-6 sm:px-8 sm:pt-9">
  <a href={url('/')} class="group flex items-center gap-2 text-ink no-underline" aria-label="Almost Original, home">
    <Sprig class="h-7 w-5 text-accent transition-transform duration-500 group-hover:-rotate-6" />
    <span class="font-serif text-lg italic tracking-tight">almost original</span>
  </a>
  <nav aria-label="Primary">
    <ul class="flex items-center gap-1 text-[0.95rem] sm:gap-2">
      {items.map((item) => {
        const active = item.match(path);
        return (
          <li>
            <a
              href={url(item.href)}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative rounded-full px-3 py-1.5 transition-colors duration-300',
                active ? 'text-ink' : 'text-ink-soft hover:text-ink',
              ]}
            >
              {item.label}
              {active && <span aria-hidden="true" class="absolute -bottom-0.5 left-1/2 h-1 w-1 -translate-x-1/2 rounded-full bg-accent"></span>}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
